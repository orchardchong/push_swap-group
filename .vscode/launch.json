/* Flow of debugging using launch.json
F5
 ↓
Read launch.json
 ↓
See "preLaunchTask": "build-debug"
 ↓
Run the build task
 ↓
make debug MAIN="..."
 ↓
Create ./a.out
 ↓
Start GDB
 ↓
GDB runs ./a.out
*/
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Debug rotations",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/push_swap",
            "args": ["--bench", "--simple", "\"5 4 3 2 1\""],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
